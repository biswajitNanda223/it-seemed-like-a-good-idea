{
  "name": "agentic-rag-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run build -w @platform/contracts -w @platform/config -w @platform/database -w @platform/cache -w @platform/security -w @platform/databricks",
    "build:apps": "npm run build -w @app/agent -w @app/gateway -w @app/ingestion",
    "dev": "npm run dev -w @app/gateway",
    "lint": "eslint .",
    "typecheck": "npm run build:packages && npm run typecheck -w @app/agent -w @app/gateway -w @app/ingestion",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "security:secrets": "secretlint \"**/*.ts\" \"**/*.js\" \"**/*.json\" \"**/*.yml\" \"**/*.yaml\" \"**/*.md\" \"**/*.tf\"",
    "ax:validate": "node scripts/validate-ax-manifests.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run ax:validate && npm run security:secrets"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.1",
    "@types/node": "^22.18.6",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "prisma": "^6.16.3",
    "secretlint": "^11.3.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
