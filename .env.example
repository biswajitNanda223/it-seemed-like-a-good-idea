NODE_ENV=development
LOG_LEVEL=info
PORT=8080
AGENT_SERVICE_URL=http://localhost:8081
DATABASE_URL=postgresql://app:app@localhost:5432/agentic_rag
REDIS_URL=redis://localhost:6379
GCP_PROJECT_ID=replace-with-project-id
GCP_LOCATION=us-central1
GOOGLE_CLOUD_PROJECT=replace-with-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_RAG_CORPUS=projects/PROJECT/locations/us-central1/ragCorpora/CORPUS
AGENT_MODEL=gemini-2.5-flash
JWT_ISSUER=https://securetoken.google.com/replace-with-project-id
JWT_AUDIENCE=replace-with-project-id
CACHE_TTL_SECONDS=300
SESSION_TTL_SECONDS=86400
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
