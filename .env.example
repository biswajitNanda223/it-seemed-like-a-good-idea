NODE_ENV=development
LOG_LEVEL=info
PORT=8080
AGENT_SERVICE_URL=http://localhost:8081
DATABASE_URL=postgresql://app:app@localhost:5432/agentic_rag
REDIS_URL=redis://localhost:6379
QUEUE_REDIS_URL=redis://localhost:6380
QUEUE_REDIS_HOST=queue-redis.example.internal:6379
QUEUE_REDIS_PASSWORD=load-from-secret-manager
GCP_PROJECT_ID=replace-with-project-id
GCP_LOCATION=us-central1
GOOGLE_CLOUD_PROJECT=replace-with-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_RAG_CORPUS=projects/PROJECT/locations/us-central1/ragCorpora/CORPUS
RETRIEVAL_BACKEND=vertex
DATABRICKS_HOST=https://your-workspace.gcp.databricks.com
DATABRICKS_CLIENT_ID=service-principal-client-id
DATABRICKS_CLIENT_SECRET=load-from-secret-manager
DATABRICKS_SQL_WAREHOUSE_ID=warehouse-id
DATABRICKS_VECTOR_INDEX=main.knowledge.documents_index
DATABRICKS_VECTOR_COLUMNS=id,title,content,source_uri,tenant_id
DATABRICKS_ALLOWED_VIEWS=main.agent.customer_summary,main.agent.order_summary
AGENT_MODEL=gemini-2.5-flash
JWT_ISSUER=https://securetoken.google.com/replace-with-project-id
JWT_AUDIENCE=replace-with-project-id
CACHE_TTL_SECONDS=300
SESSION_TTL_SECONDS=86400
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
